{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["branch-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["POSTGRES_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker"
    }
  ]
}
